# Copy to .env and fill in for your environment.
# In production, DATABASE_URL/JWT secrets/etc. should come from your hosting
# provider's secret manager, not this file.

DATABASE_URL="postgresql://marketplace:marketplace_dev@localhost:5432/marketplace_dev"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000

# How long a dealer has to post a status update on an accepted lead before it
# reopens to every matched dealer again.
LEAD_SLA_HOURS=6

# OTP delivery is mocked in dev (the code is returned in the API response and
# logged) — swap this module for a real provider (Twilio, etc.) before going
# live. See src/auth/otp.service.ts.
OTP_MOCK_MODE=true

# Gemini API key — get one free at https://aistudio.google.com/apikey.
# Powers the AI assistant, offline-dealer chat auto-reply, and AI chat
# monitoring. Without it, those features are disabled gracefully (see
# src/ai/gemini.client.ts) — everything else in the app still works.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
