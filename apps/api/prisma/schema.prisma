// Real Estate Marketplace — data model.
// See .agents/skills/prisma-upgrade-v7 for the v7 patterns this follows
// (driver adapters, generated client output path, prisma.config.ts).

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  DEALER
  ADMIN
  COMPANY
}

enum KycStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  HOUSE
  APARTMENT
  PLOT
  COMMERCIAL
}

enum ListingPurpose {
  SALE
  RENT
}

enum ListingSource {
  DEALER
  OWNER
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  ARCHIVED
}

enum RequirementStatus {
  OPEN
  CLOSED
  CANCELLED
}

// The operational unit dealers claim. One Requirement has at most one *live*
// Lead at a time; history of who held it lives in LeadAssignment.
enum LeadStatus {
  BROADCAST // visible to every matched dealer, unclaimed
  ACCEPTED // a dealer has claimed it and the SLA clock is running
  CLOSED_WON
  CLOSED_LOST
}

enum LeadStage {
  CONTACTED
  VISIT_SCHEDULED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum LeadAssignmentOutcome {
  RELEASED_SLA // dealer let the 6h window lapse with no update
  CLOSED_WON
  CLOSED_LOST
  REASSIGNED_BY_ADMIN
}

enum OtpPurpose {
  REGISTER
  LOGIN
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  role            Role
  phone           String    @unique
  email           String?   @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dealerProfile DealerProfile?
  companyOwned  Company?       @relation("CompanyOwner")

  listings          Listing[]
  requirements      Requirement[]
  leadsAsDealer     Lead[]                     @relation("LeadDealer")
  leadAssignments   LeadAssignment[]
  leadStatusUpdates LeadStatusUpdate[]
  messages          Message[]
  conversations     ConversationParticipant[]
  reviewsGiven      Review[]                   @relation("ReviewAuthor")
  reviewsReceived   Review[]                   @relation("ReviewSubject")
  notifications     Notification[]
  reports           Report[]
  refreshTokens     RefreshToken[]
  auditLogEntries   AuditLog[]

  @@index([role])
}

model DealerProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyName     String?
  licenseNumber  String?
  kycStatus      KycStatus      @default(UNSUBMITTED)
  kycDocumentUrl String?
  coverageCities String[]       @default([])
  propertyTypes  PropertyType[] @default([])
  ratingAvg      Float          @default(0)
  ratingCount    Int            @default(0)
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId])
}

// A company/agency account that owns many dealers. The owner (a User with
// role COMPANY) signs in and sees a rollup of every dealer who joined via
// the invite code — dealers opt in themselves, the company can't add them.
model Company {
  id         String   @id @default(cuid())
  name       String
  ownerId    String   @unique
  owner      User     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dealers DealerProfile[]
}

model OtpCode {
  id         String     @id @default(cuid())
  identifier String // phone number
  code       String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([identifier, purpose])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

model Listing {
  id           String         @id @default(cuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  source       ListingSource
  status       ListingStatus  @default(PENDING)
  purpose      ListingPurpose
  propertyType PropertyType
  title        String
  description  String
  price        Decimal        @db.Decimal(14, 2)
  city         String
  area         String
  beds         Int?
  baths        Int?
  sizeValue    Float?
  sizeUnit     String? // "marla" | "kanal" | "sqft"
  verified     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  photos        ListingPhoto[]
  conversations Conversation[]
  reports       Report[]

  @@index([status, purpose, propertyType, city])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
}

// ---------------------------------------------------------------------------
// Requirements & Leads — the accept/lock/SLA-release mechanic
// ---------------------------------------------------------------------------

model Requirement {
  id           String            @id @default(cuid())
  customerId   String
  customer     User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  propertyType PropertyType
  purpose      ListingPurpose
  city         String
  area         String?
  budgetMin    Decimal?          @db.Decimal(14, 2)
  budgetMax    Decimal?          @db.Decimal(14, 2)
  beds         Int?
  notes        String?
  status       RequirementStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  leads Lead[]

  @@index([status, city, propertyType])
}

model Lead {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  status        LeadStatus  @default(BROADCAST)

  dealerId    String?
  dealer      User?     @relation("LeadDealer", fields: [dealerId], references: [id])
  acceptedAt  DateTime?
  slaDeadline DateTime?
  inviteToken String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusUpdates LeadStatusUpdate[]
  assignments   LeadAssignment[]
  conversations Conversation[]

  @@index([status, dealerId])
  @@index([slaDeadline])
}

// Structured stage picker a dealer taps through — see the screen inventory's
// D-05. Every insert here also pushes Lead.slaDeadline forward, which is
// what keeps an actively-worked lead from expiring.
model LeadStatusUpdate {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealerId  String
  dealer    User      @relation(fields: [dealerId], references: [id])
  stage     LeadStage
  note      String?
  createdAt DateTime  @default(now())
}

// One row per dealer who ever held a given lead — powers the "expired /
// released leads" log (screen D-07) and dealer performance stats.
model LeadAssignment {
  id         String                 @id @default(cuid())
  leadId     String
  lead       Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealerId   String
  dealer     User                   @relation(fields: [dealerId], references: [id])
  acceptedAt DateTime               @default(now())
  releasedAt DateTime?
  outcome    LeadAssignmentOutcome?

  @@index([dealerId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Chat — admin can read any conversation; flagged messages surface for review
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  flagged        Boolean      @default(false)
  flagReason     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([flagged])
}

// ---------------------------------------------------------------------------
// Trust & safety, notifications, reviews
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  dealerId   String
  dealer     User     @relation("ReviewSubject", fields: [dealerId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("ReviewAuthor", fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([dealerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTargetType
  listingId  String?
  listing    Listing?         @relation(fields: [listingId], references: [id])
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}
